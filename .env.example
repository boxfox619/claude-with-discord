DISCORD_TOKEN=your_discord_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional: for voice message transcription
ANTHROPIC_API_KEY=sk-ant-api03-...  # Optional: set to use API key billing instead of Claude login (OAuth)
CLAUDE_CODE_PATH=/Users/you/.local/bin/claude  # Optional: use installed Claude Code CLI instead of the SDK-bundled one (needed for newer API key types)
